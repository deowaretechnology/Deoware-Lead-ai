# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Get this from MongoDB Atlas -> Connect -> Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai-crm?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# --- Phase 2: Outreach Agent ---

# Anthropic Console (console.anthropic.com) -> API Keys
ANTHROPIC_API_KEY=
# Model used to draft outreach/follow-up messages (Haiku is cheap and plenty for this)
CLAUDE_OUTREACH_MODEL=claude-haiku-4-5-20251001

# Resend (resend.com) -> API Keys. Free tier covers plenty of outreach volume.
RESEND_API_KEY=
# Must be a verified sender on your Resend account (or use their test address below)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Meta WhatsApp Cloud API - from Meta for Developers -> your App -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Set to "true" once the above keys are filled in and tested, to turn on the
# daily automatic follow-up sweep. Leave "false" while you're still testing
# manually so it doesn't fire on bad/missing keys.
ENABLE_AUTO_FOLLOWUP=false
# Cron schedule for the follow-up sweep (default: 10:00 AM server time, daily)
FOLLOWUP_CRON=0 10 * * *

# --- Phase 3: Content Agent ---

# Model for writing social posts (Sonnet = better writing, still cheap at 1 post/day)
CLAUDE_CONTENT_MODEL=claude-sonnet-5

# Your Facebook Page id + a long-lived Page access token
# (needs pages_manage_posts, pages_read_engagement, instagram_basic,
#  instagram_content_publish permissions - see README for how to get it)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Instagram Business/Creator account id linked to that Page
META_IG_USER_ID=

# Turn on the content scheduler (publishes scheduled posts, daily AI post,
# metrics sync). Leave false until the Meta keys above are set and a manual
# "Publish now" works.
ENABLE_CONTENT_AGENT=false
# How often to check for scheduled posts that are due (default every 10 min)
CONTENT_PUBLISH_CRON=*/10 * * * *
# Daily AI post generation + metrics sync (default 08:30 server time)
CONTENT_DAILY_CRON=30 8 * * *

# --- Phase 4: Unified Inbox ---

# Meta App -> Settings -> Basic -> App Secret. Used to check that webhook
# calls really come from Meta. Required in production.
META_APP_SECRET=
# Any random string you make up - paste the same value into the Meta App's
# webhook settings ("Verify token") when you add the callback URL
META_WEBHOOK_VERIFY_TOKEN=
# Which CRM account receives incoming DMs/comments (defaults to the first account created)
INBOX_OWNER_EMAIL=
# Where to email "new lead" / "wants a demo" alerts (defaults to the owner's
# account email). Needs RESEND_API_KEY from Phase 2 - without it alerts are just logged.
NOTIFY_EMAIL=
# Model for classifying messages + drafting replies (Haiku = cheap and fast)
CLAUDE_INBOX_MODEL=claude-haiku-4-5-20251001

# --- Phase 5: Lead Finder ---

# Google Cloud Console -> APIs & Services -> enable "Places API (New)" ->
# Credentials -> API key (restrict it to Places API). Billing must be enabled
# on the project, but the monthly free allowance covers normal use.
GOOGLE_PLACES_API_KEY=
# Safety cap on Google calls per month (each call = up to 20 businesses).
# Default 900 keeps you under Google's 1,000 free calls/month for this SKU.
PLACES_MONTHLY_REQUEST_LIMIT=900
# Country bias for searches
PLACES_REGION_CODE=IN
# "Find contacts" scraper (reads the business's OWN website: homepage + up to
# 2 contact/about pages, obeys robots.txt). Optional tweaks:
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; CRMContactBot/1.0; business contact lookup)
SCRAPER_DELAY_MS=700

# --- Background jobs on free hosting ---
# Long random string. Enables secret URLs that an external cron service
# (cron-job.org, free) calls to run jobs, e.g.
#   https://YOUR-BACKEND/api/cron/daily?key=THIS_VALUE      (once a day)
#   https://YOUR-BACKEND/api/cron/publish?key=THIS_VALUE    (every 10-15 min)
# Leave empty to disable the URLs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- Daily outreach (automatic first messages + follow-ups) ---

# Your public backend URL (used for unsubscribe links in emails), e.g. https://your-app.onrender.com
PUBLIC_API_URL=
# Your timezone offset in minutes - daily limits reset at your midnight (IST = 330)
APP_TZ_OFFSET_MINUTES=330

# Cold email - from YOUR OWN mailbox (Zoho / Google Workspace), NOT Resend
# (Resend forbids cold outreach). Use a separate domain for cold email.
# Zoho: smtp.zoho.in, port 465, secure=true, app-specific password
# Google Workspace: smtp.gmail.com, port 465, secure=true, app password
COLD_EMAIL_SMTP_HOST=
COLD_EMAIL_SMTP_PORT=465
COLD_EMAIL_SMTP_SECURE=true
COLD_EMAIL_SMTP_USER=
COLD_EMAIL_SMTP_PASS=
COLD_EMAIL_FROM="Raj from Deoware <raj@yourdomain.com>"
# Shown in every email footer (required in the US by CAN-SPAM; good practice everywhere)
COLD_EMAIL_POSTAL_ADDRESS=Deoware, Kolkata, West Bengal, India

# Email verification before sending: free DNS check always runs.
# Optional mailbox-level check with ZeroBounce:
EMAIL_VERIFY_PROVIDER=
ZEROBOUNCE_API_KEY=

# WhatsApp cold messages must use templates approved in Meta Business Manager.
# The template's {{1}} is filled with the business name.
WHATSAPP_OUTREACH_TEMPLATE=
WHATSAPP_FOLLOWUP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Set to false if your template has no {{1}} variable
WHATSAPP_TEMPLATE_USES_NAME=true

# Daily limits (automatic email/WhatsApp are hard caps incl. follow-ups;
# Instagram/Facebook are the size of the Today send lists)
COLD_EMAIL_DAILY_LIMIT=25
WHATSAPP_DAILY_LIMIT=20
INSTAGRAM_DAILY_TARGET=20
FACEBOOK_DAILY_TARGET=20

# --- Auto-Finder (daily new leads from saved searches) ---
AUTO_FINDER_DAILY_TARGET=50
AUTO_FINDER_MIN_SCORE=60
AUTO_FINDER_MAX_CALLS_PER_RUN=10
AUTO_FINDER_ENRICH=true
